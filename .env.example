# ==============================================================================
# GameVault API - Environment Configuration Example
# Copy this file to .env and customize values for production deployment
# ==============================================================================

# Application Security
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com

# Database Selection: 'sqlite' (for local dev) or 'mysql' (for production)
DB_ENGINE=mysql

# MySQL Database Credentials
DB_NAME=gamevault_db
DB_USER=gamevault_user
DB_PASSWORD=your_strong_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# API Defaults
DEFAULT_RATE_LIMIT=60
